# Discord (primary bot: SNS Core)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Restrict admin/ops commands to these role IDs (comma-separated)
ADMIN_ROLE_IDS=

# MongoDB (reuse SNS-web cluster or a dedicated DB)
MONGODB_URI=

# Webhook receiver (Netlify deploy hooks, Arcjet alerts, site inquiries -> this bot)
WEBHOOK_PORT=3001
WEBHOOK_SECRET=
ALERTS_CHANNEL_ID=
DEPLOYS_CHANNEL_ID=
INQUIRIES_CHANNEL_ID=

# REST API for the website (status reads + maintenance/lockdown/kepler control).
# Required for /api/* routes to work at all — they refuse requests if this is unset.
API_KEY=

# SNS Core website gateway. Register each bot in the Core Owner Panel first.
SNS_CORE_COMMAND_URL=https://core.sentinelnetworksystems.com/api/bot/commands
SNS_CORE_WEBHOOK_URL=https://core.sentinelnetworksystems.com/api/webhooks/bot-event
BOT_WEBHOOK_SECRET=
SNS_CORE_BOT_ID=
SNS_CORE_BOT_TOKEN=
SNS_NOTIFICATION_WEBHOOK_URL=
SNS_RAILWAY_DEPLOY_HOOK_URL=

# Site health check (/site-status)
SITE_URL=

# SNS-web account tools (/account-lookup, /account-reset)
# Verify these against your actual Mongoose user schema before using in production.
USERS_COLLECTION=users
USER_EMAIL_FIELD=email
USER_PASSWORD_FIELD=password

# --- Additional bots (optional) ---
# Uncomment matching entries in bots.config.js and fill these in to run more bots
# from this same codebase.
# TUNES_DISCORD_TOKEN=
# TUNES_DISCORD_CLIENT_ID=
# TUNES_DISCORD_GUILD_ID=
# SNS_TUNES_BOT_ID=
# SNS_TUNES_BOT_TOKEN=
# SNS_TUNES_NOTIFICATION_WEBHOOK_URL=
# SNS_TUNES_RAILWAY_DEPLOY_HOOK_URL=
# THIRD_DISCORD_TOKEN=
# THIRD_DISCORD_CLIENT_ID=
# THIRD_DISCORD_GUILD_ID=
# SNS_THIRD_BOT_ID=
# SNS_THIRD_BOT_TOKEN=
# SNS_THIRD_NOTIFICATION_WEBHOOK_URL=
# SNS_THIRD_RAILWAY_DEPLOY_HOOK_URL=
# SNS_TUNES_BOT_ID=
# SNS_TUNES_BOT_TOKEN=
