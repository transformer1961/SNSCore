# SNSCore environment template
# Copy this file to .env for local development only.
# For a hosted runtime, add these names to the service environment variables.
# Never commit the real .env file or real secrets.
# Generate each secret as a cryptographically secure random 32-byte value.

# ── 1. Discord logins (Discord Developer Portal) ─────────────────
# Main bot: Discord Developer Portal -> application -> Bot -> Reset Token.
# Get client and guild IDs from General Information and Discord Developer Mode.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Discord server ID treated as the development server by /infomssge.
SNS_DEV_GUILD_ID=

# Role IDs allowed to use admin/ops commands (comma-separated)
ADMIN_ROLE_IDS=

# Tunes bot (leave blank to skip it)
TUNES_DISCORD_TOKEN=
TUNES_DISCORD_CLIENT_ID=
TUNES_DISCORD_GUILD_ID=

# Third bot (leave blank to skip it)
THIRD_DISCORD_TOKEN=
THIRD_DISCORD_CLIENT_ID=
THIRD_DISCORD_GUILD_ID=

# ── 2. Connection to Core (the website) ──────────────────────────
# Each bot needs: an ID + token from Core, and the shared secret.
# To get a token: enroll the bot in Core, approve it in the owner
# panel, then paste the token here. The IDs must match what you enroll.
SNS_CORE_COMMAND_URL=https://core.sentinelnetworksystems.com/api/bot/commands
SNS_CORE_WEBHOOK_URL=https://core.sentinelnetworksystems.com/api/webhooks/bot-event
# Must match the BOT_WEBHOOK_SECRET in Core's Netlify env vars.
BOT_WEBHOOK_SECRET=

SNS_CORE_BOT_ID=sns_core
SNS_CORE_BOT_TOKEN=

SNS_TUNES_BOT_ID=sns_tunes
SNS_TUNES_BOT_TOKEN=

SNS_THIRD_BOT_ID=sns_third
SNS_THIRD_BOT_TOKEN=

# ── 3. Database & webhooks ───────────────────────────────────────
MONGODB_URI=
WEBHOOK_PORT=3001
WEBHOOK_SECRET=
ALERTS_CHANNEL_ID=
DEPLOYS_CHANNEL_ID=
INQUIRIES_CHANNEL_ID=
API_KEY=
SNS_NOTIFICATION_WEBHOOK_URL=
SNS_RAILWAY_DEPLOY_HOOK_URL=
