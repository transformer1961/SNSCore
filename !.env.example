# SNSCore environment template
# Copy this file to .env and replace all placeholder values.

# Core Discord bot
DISCORD_TOKEN="replace_with_discord_bot_token"
DISCORD_CLIENT_ID="replace_with_discord_application_id"
DISCORD_GUILD_ID="replace_with_discord_server_id"
ADMIN_ROLE_IDS="replace_with_admin_role_id"

# Core gateway settings
SNS_CORE_COMMAND_URL="https://your-domain.example.com/api/bot/commands"
SNS_CORE_WEBHOOK_URL="https://your-domain.example.com/api/webhooks/bot-event"
BOT_WEBHOOK_SECRET="replace_with_a_long_random_secret"
SNS_CORE_BOT_ID="sns_core_production"
SNS_CORE_BOT_TOKEN="replace_with_generated_core_bot_token"

# Database and webhooks
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
WEBHOOK_PORT="3001"
WEBHOOK_SECRET="replace_with_a_long_random_secret"
API_KEY="replace_with_a_long_random_api_key"
ALERTS_CHANNEL_ID=""
DEPLOYS_CHANNEL_ID=""
INQUIRIES_CHANNEL_ID=""
USERS_COLLECTION="users"
USER_EMAIL_FIELD="email"
USER_PASSWORD_FIELD="password"
SNS_NOTIFICATION_WEBHOOK_URL=""
SNS_RAILWAY_DEPLOY_HOOK_URL=""

# Additional bot apps
TUNES_DISCORD_TOKEN="replace_with_tunes_discord_bot_token"
TUNES_DISCORD_CLIENT_ID="replace_with_tunes_discord_app_id"
TUNES_DISCORD_GUILD_ID="replace_with_tunes_discord_server_id"
SNS_TUNES_BOT_ID="sns_tunes_production"
SNS_TUNES_BOT_TOKEN="replace_with_generated_tunes_bot_token"

THIRD_DISCORD_TOKEN="replace_with_third_discord_bot_token"
THIRD_DISCORD_CLIENT_ID="replace_with_third_discord_app_id"
THIRD_DISCORD_GUILD_ID="replace_with_third_discord_server_id"
SNS_THIRD_BOT_ID="sns_third_production"
SNS_THIRD_BOT_TOKEN="replace_with_generated_third_bot_token"